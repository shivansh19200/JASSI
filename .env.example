# Required: get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default chat/vision models
# (defaults are Groq's current recommended models as of Sept 2026 —
#  llama-3.3-70b-versatile was decommissioned on 2026-08-16)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: only needed if you wire up the Google Calendar OAuth flow
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
